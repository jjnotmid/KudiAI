# ── LLM (agent brain) ────────────────────────────────────────────────
# Free tier, no credit card. Get GEMINI_API_KEY from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq is the failover LLM AND the Whisper speech-to-text provider.
# Get from https://console.groq.com/keys
GROQ_API_KEY=
# gemini | groq | claude   (adapter picks the primary; failover is automatic)
LLM_PROVIDER=gemini

# ── Money provider (BMONI) ───────────────────────────────────────────
# sim | live   — default sim until a BMONI_API_KEY exists.
MONEY_PROVIDER=sim
# Confirmed sandbox base URL. Do NOT append /v1 (paths already include it).
BMONI_BASE_URL=https://embedded-dev.bmoni.com
# Sandbox key sent as the `x-api-key` header. Ask BMONI for this.
BMONI_API_KEY=

# ── Channel ──────────────────────────────────────────────────────────
# telegram | sim   — sim needs no credentials and runs locally/in tests.
CHANNEL=sim
# From @BotFather on Telegram. Only needed when CHANNEL=telegram.
TELEGRAM_BOT_TOKEN=
# Shared secret you invent; Telegram echoes it on every webhook call so we
# can reject forged requests. Only needed for webhook (production) mode.
TELEGRAM_WEBHOOK_SECRET=

# ── Persistence (Supabase) ───────────────────────────────────────────
# memory | supabase   — memory works with no creds (dev/tests).
STORE=memory
SUPABASE_URL=
# service_role key — SERVER ONLY, bypasses row-level security. Never client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Image storage (Cloudinary) ───────────────────────────────────────
# Server-only. The API secret must never reach the frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────
# Server-only. Without a verified domain, test mode only sends to your own
# Resend account email; RESEND_FROM stays onboarding@resend.dev.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# ── Security ─────────────────────────────────────────────────────────
# HMAC key for confirmation tokens and the session cookie.
# Generate with:  openssl rand -hex 32
# In production the app refuses to boot without this. In dev an ephemeral
# one is generated with a warning.
SESSION_SECRET=
